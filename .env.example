# Application
APP_NAME=Environmental Document Extraction API
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# Chandra's project-defined HTTP wrapper. Docker Compose overrides this with
# http://ocr:9000, using the private Compose service name.
APP_CHANDRA_BASE_URL=http://127.0.0.1:9000
APP_CHANDRA_TIMEOUT_SECONDS=90

# Request protection
APP_PROCESSING_DEADLINE_SECONDS=120
APP_MAX_CONCURRENT_REQUESTS=1
APP_MAX_FILE_SIZE_BYTES=15728640
APP_MAX_IMAGE_PIXELS=40000000

# This name is exposed only as processing metadata. Replace it when the
# field-mapping implementation is connected.
APP_MAPPER_MODEL=pending
