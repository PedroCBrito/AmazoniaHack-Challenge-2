# Application
APP_NAME=Environmental Document Extraction API
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# Chandra's project-defined HTTP wrapper. Docker Compose overrides this with
# http://ocr:9000, using the private Compose service name.
APP_CHANDRA_BASE_URL=http://127.0.0.1:9000
APP_CHANDRA_TIMEOUT_SECONDS=90

# Request protection
APP_PROCESSING_DEADLINE_SECONDS=120
APP_MAX_CONCURRENT_REQUESTS=1
APP_MAX_FILE_SIZE_BYTES=15728640
APP_MAX_IMAGE_PIXELS=40000000

# Clean images with OpenCV before OCR. Enable after comparing against raw images.
APP_IMAGE_CLEANING_ENABLED=false

# Local OpenAI-compatible text mapper. Docker Compose reaches the same service
# through http://llamactl:9099/v1 on the private llm network.
APP_MAPPER_BASE_URL=http://127.0.0.1:9099/v1
APP_MAPPER_MODEL=gemma4-31b
APP_MAPPER_TIMEOUT_SECONDS=60
APP_MAPPER_MAX_OUTPUT_TOKENS=4096

# Local OCR evidence database. Docker Compose stores this file in a named volume.
APP_DATABASE_PATH=./data/ocr.sqlite3

# OCR provider: chandra or textract.
OCR_PROVIDER=chandra

# Chandra adapter. The local llama.cpp service uses the external Docker network llm.
# Replace the URL and key when using a remote OpenAI-compatible backend.
OCR_BACKEND_BASE_URL=http://llamactl:9099/v1
OCR_BACKEND_MODEL=chandra-ocr
OCR_BACKEND_API_KEY=
OCR_MODEL_VERSION=chandra-ocr-2.Q8_0+mmproj-f16
OCR_BACKEND_TIMEOUT_SECONDS=90
OCR_MAX_OUTPUT_TOKENS=12384
OCR_MAX_CONCURRENT_REQUESTS=1
OCR_MAX_FILE_SIZE_BYTES=15728640
OCR_MAX_IMAGE_PIXELS=40000000

# Textract uses the AWS SDK credential chain. For local host execution, select
# the profile configured with `aws configure`.
AWS_REGION=eu-central-1
AWS_PROFILE=
# Absolute path to the host directory containing AWS config and credentials.
# Linux/macOS example: AWS_CONFIG_DIR=/home/your-user/.aws
# Windows example: AWS_CONFIG_DIR=C:/Users/your-user/.aws
# Required by `just start` because Compose mounts this directory into the OCR
# container. Set it even when using Chandra.
AWS_CONFIG_DIR=
# Set these to your host `id -u` and `id -g` when AWS files are mode 600.
OCR_CONTAINER_UID=1000
OCR_CONTAINER_GID=1000
